# EmailJS credentials — get these from https://dashboard.emailjs.com
# 1. Sign up / log in at emailjs.com
# 2. Email Services -> Add New Service -> connect your Gmail -> copy the Service ID
# 3. Email Templates -> Create New Template -> use variables {{from_name}}, {{from_email}}, {{subject}}, {{message}}, {{to_email}} -> copy the Template ID
# 4. Account -> General -> copy your Public Key
#
# Copy this file to .env and fill in the real values. .env is gitignored.
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
